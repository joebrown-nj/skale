{
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "watch:assets": "node scripts/build-assets.mjs --watch",
    "check:css": "node scripts/check-css-sync.mjs",
    "format:tpl": "node scripts/format-templates.mjs",
    "check:tpl": "node scripts/check-template-format.mjs",
    "check:frontend": "npm run check:css && npm run check:tpl"
  },
  "pre-commit": {
    "run": [
      "check:frontend",
      "format:tpl",
      "check:tpl",
      "check:css",
      "build:assets"
    ]
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12"
  },
  "devDependencies": {
    "@parcel/watcher": "^2.5.1",
    "esbuild": "^0.25.9",
    "lightningcss": "^1.30.1",
    "pre-commit": "^2.0.0"
  }
}
