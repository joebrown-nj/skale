<section id="rescue-form" class="section-padding contact-section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5" data-aos="fade-right">
                <div class="eyebrow">Start Here</div>

                <h2 class="display-5 mb-4">What's Wrong With Your Website?</h2>

                <p class="lead mb-4">
                    Send me the URL and tell me what you're seeing. I'll review it and determine the best next step.
                </p>

                <div class="d-flex gap-3 mb-3">
                    <span class="fit-check">✓</span>
                    <p class="text-light mb-0">No obligation to rebuild your website.</p>
                </div>

                <div class="d-flex gap-3 mb-3">
                    <span class="fit-check">✓</span>
                    <p class="text-light mb-0">Clear recommendation before work starts.</p>
                </div>

                <div class="d-flex gap-3">
                    <span class="fit-check">✓</span>
                    <p class="text-light mb-0">Fixed-price packages available from $500.</p>
                </div>
            </div>

            <div class="col-lg-6 offset-lg-1" data-aos="fade-left">
                <form action="{$smarty.ENV.SITE_URL}post-lead-form" method="POST" class="ajaxForm lead-form" id="website-rescue-form" data-meta-form-name="website-rescue-form" data-meta-success-event="Lead" data-meta-success-custom-event="WebsiteRescueSubmitted" data-meta-start-custom-event="WebsiteRescueStarted">
                    <input type="hidden" name="form_type" value="landing-page">
                    <input type="hidden" name="lead_source" value="website-rescue" />

                    <h3 class="h3 mb-2">Request a Website Review</h3>

                    <p class="text-secondary mb-4">
                        You don't need to diagnose the problem yourself. Just tell me what's happening.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="name" class="form-label"> Name </label>

                            <input type="text" class="form-control" id="name" name="name" autocomplete="given-name" required />
                        </div>

                        <div class="col-md-6">
                            <label for="email" class="form-label"> Email </label>

                            <input type="email" class="form-control" id="email" name="email" autocomplete="email" required />
                        </div>

                        <div class="col-12">
                            <label for="website" class="form-label"> Website URL </label>

                            <input type="url" class="form-control" id="website" name="website" placeholder="https://yourwebsite.com" required />
                        </div>

                        <div class="col-12">
                            <label for="problem" class="form-label"> What's happening? </label>

                            <textarea class="form-control" id="problem" name="comment" placeholder="Example: Our site is slow on mobile and people are telling us the contact form isn't working." required></textarea>
                        </div>

                        <div class="col-12">
                            <label for="package" class="form-label">
                                What kind of help are you considering?
                            </label>

                            <select class="form-select" id="package" name="package">
                                <option value="">I'm not sure yet</option>
                                <option value="quick-fix">$500 Quick Fix</option>
                                <option value="website-rescue">$1,000 Website Rescue</option>
                                <option value="conversion-sprint">$2,000 Conversion Sprint</option>
                                <option value="other">Something larger / different</option>
                            </select>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-rescue btn-lg w-100" aria-describedby="48-Hour Website Rescue lead form">
                                Review My Website
                            </button>
                        </div>

                        <div class="col-12">
                            <p class="small-note text-center mb-0">
                                No generic sales pitch. I'll review what you send and tell you whether a Website Rescue makes sense.
                            </p>
                        </div>
                    </div>
                    {include file="inc/layout/cloudflare-turnstile.tpl"}
                </form>
            </div>
        </div>
    </div>
</section>

