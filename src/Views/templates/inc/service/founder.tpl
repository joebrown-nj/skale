<!-- FOUNDER / TRUST -->
<section class="section-space">
    <div class="container">
        <div class="founder-panel">
            <div class="row align-items-center g-4">
                <div class="col-lg-auto">
                    <!-- Replace initials with a professional founder photo for stronger trust. -->
                    <div class="{$data.avatar.class}" aria-label="{$data.avatar.alt}">{$data.avatar.value}</div>
                </div>

                <div class="col-lg">
                    <span class="quote-mark" aria-hidden="true">“</span>
                    <h2 class="h3">{$data.heading}</h2>
                    <p class="mb-2">{$data.description}</p>
                    <p class="mb-0"><strong class="text-dark">{$data.emphasis}</strong></p>
                </div>

                <div class="col-lg-auto">
                    <a class="{$data.cta.class}" href="{$data.cta.url}">{$data.cta.label}</a>
                </div>
            </div>
        </div>
    </div>
</section>


